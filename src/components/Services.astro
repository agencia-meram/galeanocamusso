---
import { SERVICES } from "../config";

const ICONS: Record<string, string> = {
  "01": '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M8 6h8M8 10h1M12 10h1M16 10h1M8 14h1M12 14h1M16 14h1M8 18h1M12 18h1M16 18h1"/>',
  "02": '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v5M16 4v5M8 14h3M8 17h3M15 14h1M18 14h1M15 17h1M18 17h1"/>',
  "03": '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8M8 10h8M8 14h5M8 18h5"/>',
  "04": '<path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9.5" cy="7" r="4"/><path d="M17 11l1.5 3L22 14.5 18.5 16 17 19l-1.5-3L12 14.5 15.5 13 17 11z"/>',
  "05": '<path d="M12 22s-7-4.2-7-10a7 7 0 0 1 14 0c0 5.8-7 10-7 10z"/><path d="M9 12l2 2 4-4"/>',
  "06": '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M7 7V5a5 5 0 0 1 10 0v2"/><path d="M8 12h8M8 16h5"/>',
};
---

<section class="section section--tint" id="servicios" aria-labelledby="servicios-title">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <p class="section-index">Servicios</p>
      <h2 id="servicios-title">Nuestra propuesta de valor</h2>
    </div>

    <div class="services-grid">
      {SERVICES.map((s, i) => (
        <div class="service-card reveal" style={`--rd:${(i % 3) * 0.1}s`}>
          <span class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.n] ?? ICONS["01"]} />
          </span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          <a class="service-more" href="#contacto" aria-label={`Consultar por ${s.title}`}>
            Más información
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
