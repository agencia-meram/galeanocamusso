---
import { SITE, CONTACT, LEGAL, whatsappLink } from "../config";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/#inicio" aria-label={`${SITE.name} — inicio`}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 1024 724" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" style="width:100%;height:100%">
              <text x="50%" y="58%" text-anchor="middle" dominant-baseline="middle" font-family="Georgia, 'Times New Roman', serif" font-size="340" font-weight="900" fill="#8c56d4" stroke="#8c56d4" stroke-width="4">G&amp;C</text>
            </svg>
          </span>
          <span class="brand-name">
            {SITE.name}
            <span class="brand-sub">{SITE.tagline}</span>
          </span>
        </a>
        <p>
          Estudio contable online. Liquidación de impuestos, sueldos y contabilidad
          para PyMEs, monotributistas y responsables inscriptos. Cita presencial a coordinar.
        </p>
      </div>

      <nav aria-label="Enlaces del pie">
        <h2>Navegación</h2>
        <ul class="footer-links">
          <li><a href="/#estudio">El estudio</a></li>
          <li><a href="/#servicios">Servicios</a></li>
          <li><a href="/#proceso">Cómo trabajamos</a></li>
          <li><a href="/#preguntas">Preguntas frecuentes</a></li>
          <li><a href="/#contacto">Contacto</a></li>
        </ul>
      </nav>

      <div>
        <h2>Contacto</h2>
        <ul class="footer-contact">
          <li>
            <a href={whatsappLink("Hola Vengo del sitio de Galeano & Camusso, quiero contactar al estudio.")} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp del estudio pie de página: ${CONTACT.whatsappDisplay}`}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.87 9.87 0 0 0 4.73 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.12h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z" />
              </svg>
              {CONTACT.whatsappDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${CONTACT.contactEmail}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                <path d="M2.5 7l9.5 6 9.5-6" />
              </svg>
              {CONTACT.contactEmail}
            </a>
          </li>
          {false && CONTACT.instagram && (
            <li>
              <a href={CONTACT.instagram} target="_blank" rel="noopener noreferrer" aria-label={`Instagram de ${SITE.name} (abre en pestaña nueva)`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none" />
                </svg>
                Instagram
              </a>
            </li>
          )}
          {false && CONTACT.linkedin && (
            <li>
              <a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn de ${SITE.name} (abre en pestaña nueva)`}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M4.98 3.5A2.49 2.49 0 0 1 2.5 6a2.49 2.49 0 0 1-2.5-2.5A2.49 2.49 0 0 1 4.98 3.5zM.5 8.75h4.96V23.5H.5V8.75zM8.46 8.75h4.75v2.03h.07c.66-1.2 2.27-2.47 4.67-2.47 5 0 5.92 3.29 5.92 7.57v7.62h-4.95v-6.75c0-1.61-.03-3.68-2.24-3.68-2.24 0-2.59 1.75-2.59 3.56v6.87H8.46V8.75z" />
                </svg>
                LinkedIn
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="footer-legal">
      <p>
        {LEGAL.titular} · {LEGAL.cuit ? `CUIT ${LEGAL.cuit} · ` : ""}{LEGAL.domicilioLegal ? `${LEGAL.domicilioLegal} · ` : ""}{SITE.address}
        <br />
        <span style="opacity:.85">{LEGAL.cuit || LEGAL.domicilioLegal ? "" : "CUIT y domicilio legal en trámite · "}Matrículas profesionales en trámite — CPCE correspondiente.</span>
      </p>
      <p style="margin-top:.6rem">
        <a href="/privacidad">Política de Privacidad</a> · <a href="/terminos">Términos y Aviso Legal</a> · <a href="https://www.argentina.gob.ar/produccion/defensadelconsumidor/formulario" target="_blank" rel="noopener noreferrer">Defensa del Consumidor</a>
      </p>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {SITE.name} — Estudio Contable. Todos los derechos reservados.</span>
      <div class="legal">
        <a href="/#inicio">Volver arriba ↑</a>
        <a href="/privacidad">Privacidad</a>
        <span>{SITE.address}</span>
      </div>
    </div>
  </div>
</footer>
