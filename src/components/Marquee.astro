---

<div class="stats-bar" aria-label="El estudio en cifras">
  <div class="container">
    <dl class="stats-inner">
      <div class="stat reveal">
        <dt>
          <span class="tnum stat-num">10<sup>+ años</sup></span>
        </dt>
        <dd>
          <span>Trayectoria profesional</span>
        </dd>
      </div>
      <div class="stat reveal" style="--rd:.1s">
        <dt>
          <span class="tnum stat-num">+50<sup>+</sup></span>
        </dt>
        <dd>
          <span>Clientes activos</span>
        </dd>
      </div>
      <div class="stat reveal" style="--rd:.2s">
        <dt>
          <span class="tnum stat-num">100<sup>%</sup></span>
        </dt>
        <dd>
          <span>Obligaciones al día</span>
        </dd>
      </div>
      <div class="stat reveal" style="--rd:.3s">
        <dt>
          <span class="tnum stat-num">&lt; 24<sup> hs</sup></span>
        </dt>
        <dd>
          <span>Tiempo de respuesta</span>
        </dd>
      </div>
    </dl>
  </div>
</div>
