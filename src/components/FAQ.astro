---
import { FAQS, whatsappLink } from "../config";
---

<section class="section" id="preguntas" aria-labelledby="preguntas-title">
  <div class="container">
    <div class="faq-grid">
      <div class="faq-sticky-note reveal">
        <p class="section-index">Preguntas frecuentes</p>
        <h2 class="display" id="preguntas-title" style="font-size:clamp(1.9rem,3.8vw,2.5rem);margin:.9rem 0 0;line-height:1.16">
          Respondemos las <em>dudas más comunes</em>
        </h2>
        <div class="faq-side-card">
          <h3>¿No encontrás tu pregunta?</h3>
          <p>Escribinos directamente: contestamos todos los días hábiles, de 9 a 18 h.</p>
          <a class="btn btn-whatsapp" href={whatsappLink("Hola 👋 Tengo una consulta sobre los servicios del estudio.")} target="_blank" rel="noopener noreferrer" aria-label="Preguntar por WhatsApp sobre servicios">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.87 9.87 0 0 0 4.73 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.12h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z" />
            </svg>
            Preguntar por WhatsApp
          </a>
        </div>
      </div>

      <div class="faq-list reveal" style="--rd:.12s">
        {FAQS.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
