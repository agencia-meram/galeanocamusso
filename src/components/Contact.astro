---
import { SITE, CONTACT, FORM, whatsappLink } from "../config";

const services = [
  "Asesoramiento Contable",
  "Auditoría",
  "Asesoramiento Impositivo",
  "Liquidación de Sueldos",
  "Outsourcing",
];
---

<section class="section" id="contacto" aria-labelledby="contacto-title" style="padding-top:0">
  <div class="container">
    <div class="contact reveal">
    <div class="contact-grid">
      <div>
        <p class="eyebrow">Contacto</p>
        <h2 id="contacto-title">Hablemos de <em>tu caso</em></h2>
        <p class="contact-lead">
          Contanos tu situación y te respondemos con un diagnóstico integral
          y presupuesto cerrado. Atención online para todo el país · Cita presencial a coordinar.
        </p>

        <div class="contact-rows">
          <div class="contact-row">
            <span class="cr-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.87 9.87 0 0 0 4.73 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.12h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z" />
              </svg>
            </span>
            <div>
              <small>WhatsApp</small>
              <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp ${CONTACT.whatsappDisplay} — contacto directo`}>{CONTACT.whatsappDisplay}</a>
            </div>
          </div>

          <div class="contact-row">
            <span class="cr-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                <path d="M2.5 7l9.5 6 9.5-6" />
              </svg>
            </span>
            <div>
              <small>Email</small>
              <a href={`mailto:${CONTACT.contactEmail}`}>{CONTACT.contactEmail}</a>
            </div>
          </div>

          <div class="contact-row">
            <span class="cr-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3.2 1.8" />
              </svg>
            </span>
            <div>
              <small>Horario</small>
              <p>{CONTACT.schedule}</p>
            </div>
          </div>

          <div class="contact-row">
            <span class="cr-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21s-7-4.6-7-10a7 7 0 0 1 14 0c0 5.4-7 10-7 10z" />
                <circle cx="12" cy="11" r="2.6" />
              </svg>
            </span>
            <div>
              <small>Modalidad</small>
              <p>Online para todo el país · Presencial con cita previa</p>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-form-card">
        <form id="contact-form" novalidate data-endpoint={FORM.endpoint} data-subject={FORM.subject} data-wa-base={whatsappLink()} data-wa-default={whatsappLink()}>
          <div class="form-grid">
            <div class="form-field">
              <label for="f-nombre">Nombre y apellido <span aria-hidden="true">*</span></label>
              <input id="f-nombre" name="Nombre" type="text" required autocomplete="name" placeholder="Ej.: María López" />
            </div>
            <div class="form-field">
              <label for="f-tel">WhatsApp / teléfono</label>
              <input id="f-tel" name="Teléfono" type="tel" autocomplete="tel" placeholder="Ej.: 11 2345 6789" />
            </div>
            <div class="form-field">
              <label for="f-email">Email <span aria-hidden="true">*</span></label>
              <input id="f-email" name="Email" type="email" required autocomplete="email" placeholder="tucorreo@ejemplo.com" />
            </div>
            <div class="form-field">
              <label for="f-servicio">¿Qué necesitás?</label>
              <select id="f-servicio" name="Servicio">
                <option value="General" selected>General</option>
                {services.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>
            <div class="form-field full">
              <label for="f-msg">Contanos tu caso <span aria-hidden="true">*</span></label>
              <textarea id="f-msg" name="Mensaje" required placeholder="Necesito asesoramiento por una inspección / auditoría / liquidación…"></textarea>
            </div>
            <p class="form-note">* Campos obligatorios. Tus datos se usan solo para responderte.</p>
            <label class="form-privacy">
              <input type="checkbox" id="f-privacy" name="Privacidad" value="Aceptada" required />
              <span>He leído y acepto la <a href="/privacidad" target="_blank" rel="noopener noreferrer">Política de Privacidad</a> <span aria-hidden="true">*</span></span>
            </label>
            <p class="form-legal">Al enviar este formulario aceptás el tratamiento de tus datos personales (nombre, teléfono, email y mensaje) únicamente para responder a tu consulta, conforme a la Ley 25.326 de Protección de Datos Personales. Podés ejercer tus derechos de acceso, rectificación o supresión escribiendo a <a href={`mailto:${CONTACT.contactEmail}`}>{CONTACT.contactEmail}</a>. Ver <a href="/privacidad" target="_blank" rel="noopener noreferrer">Política de Privacidad</a>.</p>
            <div class="form-status" id="form-status" role="status" aria-live="polite"></div>
            <div class="form-submit-row">
              <button class="btn btn-primary" type="submit" id="form-submit">
                Enviar consulta
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                </svg>
              </button>
              <span class="form-alternative">
                ¿Más rápido? <a href={whatsappLink("Hola Quería consultar por un presupuesto rápido desde el formulario.")} target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp por presupuesto rápido">escribinos por WhatsApp</a>
              </span>
            </div>
          </div>
        </form>
      </div>
    </div>
    </div>
  </div>
</section>
