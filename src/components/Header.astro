---
import { SITE, whatsappLink } from "../config";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/#inicio" aria-label={`${SITE.name} — inicio`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 1024 724" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" style="width:100%;height:100%">
          <text x="50%" y="58%" text-anchor="middle" dominant-baseline="middle" font-family="Georgia, 'Times New Roman', serif" font-size="340" font-weight="900" fill="#8c56d4" stroke="#8c56d4" stroke-width="4">G&amp;C</text>
        </svg>
      </span>
      <span class="brand-name">
        {SITE.name}
        <span class="brand-sub">{SITE.tagline}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav-links" id="main-nav">
        <li><a href="/#estudio">El estudio</a></li>
        <li><a href="/#servicios">Servicios</a></li>
        <li><a href="/#proceso">Cómo trabajamos</a></li>
        <li><a href="/#preguntas">Preguntas</a></li>
      </ul>
      <a class="btn btn-primary nav-cta" href="/#contacto" aria-label="Ir al formulario de contacto para pedir presupuesto">Pedir presupuesto</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-label="Abrir menú" aria-controls="main-nav">
        <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h10" />
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </nav>
  </div>
</header>
